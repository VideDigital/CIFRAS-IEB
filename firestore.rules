rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owns(data) {
      return signedIn() && data.ownerId == request.auth.uid;
    }

    function isGroupMember(data) {
      return signedIn() && request.auth.uid in data.memberIds;
    }

    function isGroupOwner(data) {
      return signedIn() && data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /publicProfiles/{userId} {
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn();
      allow delete: if false;
    }

    match /songs/{songId} {
      allow create: if owns(request.resource.data);
      allow update, delete: if owns(resource.data);
      allow read: if owns(resource.data)
        || exists(/databases/$(database)/documents/shares/$(songId + "_" + request.auth.uid));
    }

    match /lists/{listId} {
      allow create: if owns(request.resource.data);
      allow read, update, delete: if owns(resource.data);
    }

    match /groups/{groupId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      allow read: if isGroupMember(resource.data);

      allow update: if isGroupOwner(resource.data)
        || (
          isGroupMember(resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.memberIds.size() < resource.data.memberIds.size()
          && !(request.auth.uid in request.resource.data.memberIds)
        );

      allow delete: if isGroupOwner(resource.data);
    }

    match /publicShares/{token} {
      allow create: if owns(request.resource.data);
      allow read: if signedIn() && resource.data.active == true;
      allow update, delete: if owns(resource.data);
    }

    match /shares/{shareId} {
      allow create: if signedIn();
      allow read: if signedIn();
      allow update: if signedIn();
      allow delete: if false;
    }
  }
}
