rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owns(data) {
      return signedIn() && data.ownerId == request.auth.uid;
    }

    function groupExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId));
    }

    function isGroupMember(groupId) {
      return signedIn()
        && groupExists(groupId)
        && request.auth.uid in
          get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isGroupOwner(groupId) {
      return signedIn()
        && groupExists(groupId)
        && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId
          == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update:
        if signedIn() && request.auth.uid == userId;

      allow delete:
        if signedIn() && request.auth.uid == userId;
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();

      allow create, update:
        if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;

      allow delete: if false;
    }

    match /songs/{songId} {
      allow create:
        if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow read:
        if owns(resource.data)
        || (
          signedIn()
          && exists(
            /databases/$(database)/documents/shares/$(songId + "_" + request.auth.uid)
          )
        );

      allow update, delete:
        if owns(resource.data);
    }

    match /lists/{listId} {
      allow create:
        if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow read, update, delete:
        if owns(resource.data);
    }

    match /groups/{groupId} {
      allow create:
        if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      allow read:
        if signedIn()
        && request.auth.uid in resource.data.memberIds;

      allow update:
        if signedIn()
        && (
          resource.data.ownerId == request.auth.uid
          ||
          (
            request.auth.uid in resource.data.memberIds
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.memberIds.size()
              < resource.data.memberIds.size()
            && !(request.auth.uid in request.resource.data.memberIds)
          )
        );

      allow delete:
        if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /groupRepertoires/{repertoireId} {
      allow create:
        if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isGroupMember(request.resource.data.groupId);

      allow read:
        if signedIn()
        && isGroupMember(resource.data.groupId);

      allow update:
        if signedIn()
        && isGroupMember(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId;

      allow delete:
        if signedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || isGroupOwner(resource.data.groupId)
        );
    }

    match /publicShares/{token} {
      allow create:
        if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow read:
        if signedIn()
        && resource.data.active == true;

      allow update, delete:
        if owns(resource.data);
    }

    match /shares/{shareId} {
      allow create:
        if signedIn()
        && request.auth.uid in request.resource.data.viewerIds;

      allow read:
        if signedIn()
        && request.auth.uid in resource.data.viewerIds;

      allow update:
        if signedIn()
        && request.auth.uid in request.resource.data.viewerIds;

      allow delete: if false;
    }
  }
}