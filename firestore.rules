rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owns(data) {
      return signedIn() && data.ownerId == request.auth.uid;
    }

    function groupExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId));
    }

    function isGroupMember(groupId) {
      return signedIn()
        && groupExists(groupId)
        && request.auth.uid in
          get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isGroupOwner(groupId) {
      return signedIn()
        && groupExists(groupId)
        && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId
          == request.auth.uid;
    }

    function hasValidSongShare(songId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/shares/$(songId + "_" + request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/shares/$(songId + "_" + request.auth.uid)
        ).data.songId == songId
        && (
          get(
            /databases/$(database)/documents/shares/$(songId + "_" + request.auth.uid)
          ).data.viewerId == request.auth.uid
          ||
          request.auth.uid in get(
            /databases/$(database)/documents/shares/$(songId + "_" + request.auth.uid)
          ).data.viewerIds
        );
    }

    match /users/{userId} {
      allow read, create, update, delete:
        if signedIn() && request.auth.uid == userId;
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();

      allow create, update:
        if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;

      allow delete: if false;
    }

    match /songs/{songId} {
      allow create:
        if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow read:
        if owns(resource.data)
        || hasValidSongShare(songId);

      allow update, delete:
        if owns(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /lists/{listId} {
      allow create:
        if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow read:
        if owns(resource.data);

      allow update:
        if owns(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete:
        if owns(resource.data);
    }

    match /groups/{groupId} {
      allow create:
        if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      allow read:
        if signedIn()
        && request.auth.uid in resource.data.memberIds;

      allow update:
        if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          resource.data.ownerId == request.auth.uid
          ||
          (
            request.auth.uid in resource.data.memberIds
            && !(request.auth.uid in request.resource.data.memberIds)
            && resource.data.memberIds.size()
              == request.resource.data.memberIds.size() + 1
            && resource.data.memberIds.toSet()
              .difference(request.resource.data.memberIds.toSet())
              .hasOnly([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["memberIds", "adminIds", "updatedAt"])
          )
        );

      allow delete:
        if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /groupRepertoires/{repertoireId} {
      allow create:
        if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isGroupMember(request.resource.data.groupId);

      allow read:
        if signedIn()
        && isGroupMember(resource.data.groupId);

      allow update:
        if signedIn()
        && isGroupMember(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "date",
          "songIds",
          "songSnapshots",
          "updatedAt"
        ]);

      allow delete:
        if signedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || isGroupOwner(resource.data.groupId)
        );
    }

    match /publicShares/{token} {
      allow create:
        if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.active == true;

      allow read:
        if signedIn()
        && resource.data.active == true;

      allow update, delete:
        if owns(resource.data);
    }

    match /shares/{shareId} {
      allow create:
        if signedIn()
        && request.resource.data.viewerId == request.auth.uid
        && request.resource.data.viewerIds.size() == 1
        && request.resource.data.viewerIds[0] == request.auth.uid
        && request.resource.data.shareToken is string
        && exists(
          /databases/$(database)/documents/publicShares/$(request.resource.data.shareToken)
        )
        && get(
          /databases/$(database)/documents/publicShares/$(request.resource.data.shareToken)
        ).data.active == true
        && get(
          /databases/$(database)/documents/publicShares/$(request.resource.data.shareToken)
        ).data.songId == request.resource.data.songId
        && get(
          /databases/$(database)/documents/publicShares/$(request.resource.data.shareToken)
        ).data.ownerId == request.resource.data.ownerId;

      allow read:
        if signedIn()
        && (
          resource.data.viewerId == request.auth.uid
          || request.auth.uid in resource.data.viewerIds
          || resource.data.ownerId == request.auth.uid
        );

      allow update: if false;

      allow delete:
        if signedIn()
        && (
          resource.data.viewerId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
        );
    }
  }
}
