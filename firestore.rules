rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(data) { return signedIn() && data.ownerId == request.auth.uid; }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /songs/{songId} {
      allow create: if owns(request.resource.data);
      allow update, delete: if owns(resource.data);
      allow read: if owns(resource.data)
        || exists(/databases/$(database)/documents/shares/$(songId + "_" + request.auth.uid));
    }

    match /lists/{listId} {
      allow create: if owns(request.resource.data);
      allow read, update, delete: if owns(resource.data);
    }

    match /publicShares/{token} {
      allow create: if owns(request.resource.data);
      allow read: if signedIn() && resource.data.active == true;
      allow update, delete: if owns(resource.data);
    }

    match /shares/{shareId} {
      allow create: if signedIn()
        && request.resource.data.viewerIds.hasOnly([request.auth.uid]);
      allow read: if signedIn()
        && request.auth.uid in resource.data.viewerIds;
      allow update: if signedIn()
        && request.auth.uid in request.resource.data.viewerIds;
      allow delete: if false;
    }
  }
}
